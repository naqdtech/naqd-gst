# ──────────────────────────────────────
# Sales QR PWA — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────

# Frappe backend URL (no trailing slash)
# In production: https://yourdomain.com
# In development with proxy: leave empty
VITE_API_BASE_URL=

# UPI Payee VPA (your company's UPI ID)
VITE_UPI_VPA=yourcompany@upi

# UPI Payee Name (appears in payment apps)
VITE_UPI_PAYEE_NAME=Your Company Name

# ──────────────────────────────────────
# WhiteBooks GST API — SERVER-SIDE ONLY
# Set these in Vercel → Project → Settings → Environment Variables.
# Do NOT prefix with VITE_ (that would leak secrets into the browser bundle).
# ──────────────────────────────────────
# WB_BASE_URL=https://api.whitebooks.in     # sandbox: https://apisandbox.whitebooks.in
# WB_CLIENT_ID=
# WB_CLIENT_SECRET=
# WB_EMAIL=your-whitebooks-registered-email@example.com
# WB_IP=203.0.113.10                         # REQUIRED — a valid IP; auth calls fail without it
# ERP_BASE_URL=https://erp.naqdexim.com      # used to validate the caller's login
